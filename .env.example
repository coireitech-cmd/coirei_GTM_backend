# gtm-crawler settings for start.bat. Copy to .env (start.bat does it on first run).
# .env is gitignored: never commit real keys.

# Required: contact address sent in the crawler's User-Agent.
GTM__IDENTITY__USER_AGENT_CONTACT=you@example.com

# Exa search API key. Empty = site crawl only (no web search, competitor search
# or LinkedIn company size).
GTM__SEARCH__API_KEY=

# Bearer token for /v1. Empty = no auth (fine locally). If set, the frontend's
# GTM_API_TOKEN must match.
GTM__API__TOKEN=

# The frontend's Vite proxy sends /v1 to http://127.0.0.1:8000.
GTM__API__PORT=8000

# Optional LLM page reading (page types + quoted company facts). Empty model = off.
# Local Ollama: install, `ollama pull qwen3:8b`, then:
#   GTM__LLM__BASE_URL=http://localhost:11434/v1
#   GTM__LLM__MODEL=qwen3:8b
# Hosted (https only): set BASE_URL, MODEL and GTM__LLM__API_KEY.
GTM__LLM__BASE_URL=
GTM__LLM__MODEL=
